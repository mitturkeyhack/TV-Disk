<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Sub">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="CardTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="Btn">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/accent_dark</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="Btn2">
        <item name="android:background">@drawable/bg_btn2</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="Back">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:text">‹  Geri</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
