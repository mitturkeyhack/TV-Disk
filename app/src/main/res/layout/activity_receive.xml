<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/back" style="@style/Back" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kablosuz al" />

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center_horizontal" android:orientation="vertical">
            <View android:id="@+id/pulse" android:layout_width="18dp" android:layout_height="18dp"
                android:background="@drawable/bg_dot" />
            <TextView android:id="@+id/statusTitle" style="@style/CardTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center"
                android:text="Gönderim bekleniyor" />
            <TextView android:id="@+id/statusSub" style="@style/Sub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                android:text="Diğer telefonda TV Disk → Kablosuz Aktar → Gönder'i aç" />
            <TextView android:id="@+id/nameText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text" android:textSize="15sp" />
            <TextView android:id="@+id/ipText" style="@style/Sub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEDEF"
                android:textColor="@color/sub" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/diskName" style="@style/CardTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/diskFree" style="@style/Sub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" />
            <TextView android:id="@+id/btnPickDisk" style="@style/Btn2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="USB diski seç" />
        </LinearLayout>

        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:textSize="13sp"
            android:text="Ekran açık kalır. Bu ekrandan çıkma, ekranı kilitleme." />
    </LinearLayout>
</ScrollView>
